PORT=8080
AWS_REGION=us-east-2

DYNAMODB_TABLE_NAME=voyouger_db
DYNAMODB_GSI_NAME=GSI1
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Change all variables below to your own values:

# AWS (for DynamoDB access)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Gemini
GEMINI_API_KEY=your_key

# Text models with documented free-tier options; actual access/quota depend on your project.
# Stop at the first validated response. A working model is preferred on subsequent requests.
LLM_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash

# TravelBuddy Visa API (https://travel-buddy.ai/api/)
VISA_API_KEY=your_visa_api_key

# Google Places API key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Only needed to import/replace the shared activity illustrations, not to view trips.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Optional planning request limits (milliseconds); invalid values use defaults.
PLANNING_EXTERNAL_TIMEOUT_MS=15000
PLANNING_GEMINI_REQUEST_TIMEOUT_MS=20000
PLANNING_GEMINI_DEADLINE_MS=60000
PLANNING_EXPLANATION_TIMEOUT_MS=15000
PLANNING_GEMINI_MAX_ATTEMPTS=4
# Temporary provider overloads pause only the affected operation briefly.
# Quota/model-unavailable cooldowns remain shared across operations.
PLANNING_GEMINI_TRANSIENT_COOLDOWN_MS=5000
# Bounded, process-local cache of fully validated generated text (not Google data).
PLANNING_NARRATIVE_CACHE_TTL_MS=1800000
GENERATION_REQUESTS_PER_MINUTE=12
# Browsing existing trip days has a separate limit from generating new plans.
VENUE_REFRESH_REQUESTS_PER_MINUTE=30
# Log counts and stage durations only; no user answers or venue content.
PLANNING_METRICS=0
