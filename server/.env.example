PORT=8080
AWS_REGION=us-east-2

DYNAMODB_TABLE_NAME=voyouger_db
DYNAMODB_GSI_NAME=GSI1
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Change all variables below to your own values:

# AWS (for DynamoDB access)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Gemini
GEMINI_API_KEY=your_key

# tries models in order, falls back if one is unavailable
LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# TravelBuddy Visa API (https://travel-buddy.ai/api/)
VISA_API_KEY=your_visa_api_key
